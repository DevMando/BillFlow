@page "/Dashboard"
@rendermode InteractiveServer

<RadzenStack AlignItems="AlignItems.Start" Orientation="Orientation.Horizontal">
    <RadzenText TextStyle="TextStyle.DisplayH4">Welcome to BillFlow @name!</RadzenText>
</RadzenStack>

<RadzenCard>
    <ChildContent>

        <RadzenRow>
            <RadzenStack Orientation="Orientation.Horizontal">
                <Tile Label="Pay Bills" LinkUrl="pay-bills" />
                <Tile Label="Manage Bills" LinkUrl="manage-bills" />
            </RadzenStack>

        </RadzenRow>

        <RadzenRow>
            <RadzenStack Orientation="Orientation.Horizontal">
                <Tile Label="Accounts" LinkUrl="accounts" />
                <Tile Label="Reports" />
            </RadzenStack>
        </RadzenRow>

    </ChildContent>
</RadzenCard>

@code {
    protected string name = String.Empty;

}
